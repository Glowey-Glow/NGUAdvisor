<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Pure-logic tests. We LINK the two Unity-free source files (SimpleJson + ProfileModel) directly into
         this test assembly instead of referencing NGUAdvisor.csproj. That deliberately avoids: the
         machine-specific Unity / Assembly-CSharp compile-time <Reference>s, the timestamped output-assembly
         name, and — critically — the Release-only DeployToInjector target on NGUAdvisor.csproj that would
         overwrite the live injected DLL. The code under test pins CultureInfo.InvariantCulture on every
         number path, so results here are identical to the net48/Mono runtime. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\NGUAdvisor\SimpleJson.cs" Link="Linked\SimpleJson.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\ProfileModel.cs" Link="Linked\ProfileModel.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\BreakpointEditor.cs" Link="Linked\BreakpointEditor.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\PriorityCatalog.cs" Link="Linked\PriorityCatalog.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\SystemCatalog.cs" Link="Linked\SystemCatalog.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\ProfileValidator.cs" Link="Linked\ProfileValidator.cs" />
    <!-- The companion's ACTUAL Timeline-Editor write path (load->mutate->validate->write-in-place->re-read),
         so the end-to-end round-trip is exercised headlessly against a real temp profile file. -->
    <Compile Include="..\..\NGUAdvisorCompanion\ProfileService.cs" Link="Linked\ProfileService.cs" />
    <Compile Include="..\..\NGUAdvisorCompanion\PipeClient.cs" Link="Linked\PipeClient.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\NumberFormatter.cs" Link="Linked\NumberFormatter.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\TitanTables.cs" Link="Linked\TitanTables.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\CampaignTables.cs" Link="Linked\CampaignTables.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\BossScale.cs" Link="Linked\BossScale.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\DiggerMath.cs" Link="Linked\DiggerMath.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\WandoosMath.cs" Link="Linked\WandoosMath.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\BloodRouter.cs" Link="Linked\BloodRouter.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\SnipeTrigger.cs" Link="Linked\SnipeTrigger.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\ExpRatio.cs" Link="Linked\ExpRatio.cs" />
    <!-- The gear optimizer's pure core. GearScorer was validated by hand against gmiclotte's tool and
         then had NO regression test under it; GearObjectives is pure data whose stat strings are matched
         by name at runtime, so a typo scores 0 forever and nothing else catches it. GearObjectiveResolver
         is the precedence table the equip path and the companion both read, and GearSignature carries
         the invariants that stop the drop trigger self-triggering. All four are Unity-free. -->
    <Compile Include="..\..\NGUAdvisor\Managers\GearScorer.cs" Link="Linked\GearScorer.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\GearObjectives.cs" Link="Linked\GearObjectives.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\GearObjectiveResolver.cs" Link="Linked\GearObjectiveResolver.cs" />
    <Compile Include="..\..\NGUAdvisor\Managers\GearSignature.cs" Link="Linked\GearSignature.cs" />
  </ItemGroup>

</Project>
