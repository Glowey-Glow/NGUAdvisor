<Project Sdk="Microsoft.NET.Sdk">

  <!--
    "Advisor Launcher.exe" — a tiny net48 console launcher that replaces Run NGU Advisor.bat so the
    thing the user double-clicks carries the advisor icon. net48 = no runtime to bundle (ships with
    Windows), ~15 KB. It mirrors "Run NGU Advisor.bat": write injector-path.txt (so the advisor can find
    the companion UI), then direct-inject NGUAdvisor.dll via smi.exe. The .bat stays as a fallback.

    Builds with just the .NET SDK via the net48 reference-assemblies NuGet (no Visual Studio / targeting
    pack), same as NGUAdvisor.csproj.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Advisor Launcher</AssemblyName>
    <RootNamespace>NGUAdvisorLauncher</RootNamespace>
    <!--
      Keep in step with Main.cs's `Version` const. This exe SHIPS — package-release.sh:109 stages it as
      "Advisor Launcher.exe" and it is the primary thing the user double-clicks — but with no <Version>
      it took the SDK default, so File Properties read 1.0.0.0 inside a zip named 2.2.0.

      Nothing scrapes this exe, so this is free. package-release.sh derives the release version from
      Main.cs alone (:45); the only thing it reads out of this binary is the injector-path.txt guard at
      :120, which greps for a string literal and does not care about the version. The SDK also appends
      the git HEAD sha here (AssemblyInformationalVersion becomes "<Version>+<40 hex>"; before this
      property existed it was "1.0.0+<40 hex>") — that is deliberate provenance and is left on.
    -->
    <Version>2.4.0</Version>
    <ApplicationIcon>advisor.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
